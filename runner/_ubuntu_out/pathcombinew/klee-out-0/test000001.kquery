array PathCanonicalizeW_ret[4] : w32 -> w8 = symbolic
array PathIsRelativeW_ret[4] : w32 -> w8 = symbolic
array PathIsUNCW_ret[4] : w32 -> w8 = symbolic
array dir[520] : w32 -> w8 = symbolic
array file[520] : w32 -> w8 = symbolic
array myPathAddBackslashW_ret[4] : w32 -> w8 = symbolic
(query [(Eq 0
             (ReadLSB w16 518 dir))
         (Eq 0
             (ReadLSB w16 518 file))
         (Ult (ReadLSB w32 0 PathIsRelativeW_ret)
              2)
         (Ult (ReadLSB w32 0 PathIsUNCW_ret)
              2)
         (Ult (ReadLSB w32 0 PathCanonicalizeW_ret)
              2)
         (Eq false
             (Eq 0
                 (ReadLSB w16 0 dir)))
         (Ult N0:(ReadLSB w32 0 myPathAddBackslashW_ret)
              2)
         (Eq false (Eq 0 N0))]
        false)
