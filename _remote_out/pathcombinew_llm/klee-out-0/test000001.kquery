array dir[520] : w32 -> w8 = symbolic
array file[520] : w32 -> w8 = symbolic
(query [(Eq 0
             (ReadLSB w16 518 dir))
         (Eq 0
             (ReadLSB w16 518 file))
         (Or (Eq 0
                 N0:(ReadLSB w16 0 dir))
             (Eq 92 N0))
         (Eq 0
             (ReadLSB w16 0 file))]
        false)
