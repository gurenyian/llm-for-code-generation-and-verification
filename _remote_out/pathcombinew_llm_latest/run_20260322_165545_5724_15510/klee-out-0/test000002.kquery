array PathIsRelativeW_ret[4] : w32 -> w8 = symbolic
array dir[520] : w32 -> w8 = symbolic
array file[520] : w32 -> w8 = symbolic
(query [(Eq 0
             (ReadLSB w16 518 dir))
         (Eq 0
             (ReadLSB w16 518 file))
         (Eq 92
             N0:(ReadLSB w16 0 dir))
         (Eq 92
             N1:(ReadLSB w16 0 file))
         (Eq false (Eq 0 N1))
         (Eq false (Eq 0 N0))
         (Ult N2:(ReadLSB w32 0 PathIsRelativeW_ret)
              2)
         (Eq false (Eq 0 N2))]
        false)
