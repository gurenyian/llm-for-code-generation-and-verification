array dir[520] : w32 -> w8 = symbolic
array file[520] : w32 -> w8 = symbolic
(query [(Eq 0
             (ReadLSB w16 518 dir))
         (Eq 0
             (ReadLSB w16 518 file))
         (Eq false
             (Eq 92
                 N0:(ReadLSB w16 0 dir)))
         (Eq false (Eq 0 N0))
         (Eq 58
             (ReadLSB w16 2 dir))
         (Eq 0
             (ReadLSB w16 0 file))]
        false)
